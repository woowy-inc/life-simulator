# App
GATEWAY_URL=http://localhost:9696

# Decay
DECAY_HUNGER=5.0
DECAY_SLEEP=3.0
DECAY_BODY=2.0
DECAY_MENTAL=2.0
DECAY_SOCIAL=1.0

# Server
SERVER_PORT=9099
EUREKA_CLIENT_DEFAULT_ZONE=http://eureka:8761/eureka/

# OAuth2
OAUTH2_RESOURCE_SERVER_JWK_URI=http://auth-service/oauth2/jwks

# Kafka
KAFKA_ACK_MODE=manual
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=need-consumer
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
KAFKA_CONSUMER_VALUE_DESERIALIZER=ru.woowy.infrastructure.serialization.EventDeserializer
KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_PRODUCER_VALUE_SERIALIZER=ru.woowy.infrastructure.serialization.EventSerializer

# Redis
REDIS_DATABASE=0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=password
REDIS_TIMEOUT=60000

# Database
DATASOURCE_URL=jdbc:postgresql://localhost:6432/lifesim_need
DATASOURCE_USERNAME=dev
DATASOURCE_PASSWORD=dev
DATASOURCE_DRIVER_NAME=org.postgresql.Driver

# JPA
JPA_SHOW_SQL=false
TIMEZONE=UTC